project: savantenvs/stream-ciphers
target: salsa20-buggy-mhh-run-2

# libFuzzer harness (libfuzzer-sys). Built by mayhem/build.sh to /mayhem/bin/salsa20
# (/mayhem/salsa20 is the upstream crate dir, so the binary goes under /mayhem/bin/).
# origin: https://app.mayhem.security/mayhemheroes/stream-ciphers/salsa20/2
cmds:
    - cmd: /mayhem/bin/salsa20
      libfuzzer: true
      env:
        TMPDIR: /tmp
